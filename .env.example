# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Defaults for scan (override via CLI flags)
MAX_EMAILS=300
LOOKBACK_DAYS=60
OUTPUT_PATH=data/applications.xlsx
DB_PATH=data/tracker.db

# Gmail OAuth files (project root)
# CREDENTIALS_PATH=credentials.json
# TOKEN_PATH=token.json

# Optional: label stored in emails.source_account (default: Gmail profile email from the token in use)
# SOURCE_ACCOUNT=me@example.com
